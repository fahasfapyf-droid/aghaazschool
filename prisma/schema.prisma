generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdmissionStatus {
  NEW
  UNDER_REVIEW
  DOCUMENTS_PENDING
  ASSESSMENT_SCHEDULED
  ASSESSMENT_COMPLETED
  APPROVED
  PAYMENT_PENDING
  ENROLLED
  REJECTED
  WAITLISTED
  WITHDRAWN
  CANCELLED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AssessmentType {
  TEST
  INTERVIEW
}

enum DecisionType {
  APPROVED
  REJECTED
  WAITLISTED
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  MONTHLY
  OTHER
}

enum AcademicTerm {
  FIRST
  SECOND
  THIRD
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ResultGrade {
  A_PLUS
  A
  B_PLUS
  B
  C
  D
  TRY_AGAIN
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
  RECEPTIONIST
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
}

model AcademicSession {
  id String @id @default(cuid())
  name String @unique
  startDate DateTime
  endDate DateTime
  applications Application[]
  exams Exam[]
  reportCardSubjects ReportCardSubject[]
  reportCardReleases ReportCardRelease[]
  createdAt DateTime @default(now())
}

model AdmissionEnquiry {
  id String @id @default(cuid())
  enquiryNumber String @unique
  studentName String
  dateOfBirth DateTime?
  gender Gender?
  guardianName String
  guardianPhone String
  guardianEmail String?
  desiredClass String
  source String?
  status String @default("new")
  notes String?
  applications Application[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(cuid())
  applicationNumber String @unique
  enquiryId String?
  sessionId String
  desiredClass String
  studentName String
  dateOfBirth DateTime?
  gender Gender?
  guardianName String
  guardianPhone String
  guardianEmail String?
  previousSchool String?
  status AdmissionStatus @default(NEW)
  assignedTo String?
  remarks String?
  enquiry AdmissionEnquiry? @relation(fields: [enquiryId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])
  documents AdmissionDocument[]
  assessments Assessment[]
  decisions AdmissionDecision[]
  payments AdmissionPayment[]
  enrollment Enrollment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sessionId, status])
}

model AdmissionDocument {
  id String @id @default(cuid())
  applicationId String
  documentType String
  fileReference String
  status DocumentStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  remarks String?
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Assessment {
  id String @id @default(cuid())
  applicationId String
  type AssessmentType
  scheduledAt DateTime
  evaluator String?
  score Decimal?
  result String?
  remarks String?
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmissionDecision {
  id String @id @default(cuid())
  applicationId String
  decision DecisionType
  decidedBy String
  decidedAt DateTime @default(now())
  remarks String?
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmissionPayment {
  id String @id @default(cuid())
  applicationId String
  feeType String
  amount Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  netAmount Decimal @db.Decimal(12,2)
  status PaymentStatus @default(PENDING)
  paymentMethod String?
  receiptNumber String? @unique
  paidAt DateTime?
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id String @id @default(cuid())
  applicationId String @unique
  studentId String @unique
  admissionNumber String @unique
  className String
  section String?
  enrolledAt DateTime @default(now())
  status String @default("active")
  application Application @relation(fields: [applicationId], references: [id])
  attendance Attendance[]
  feeInvoices FeeInvoice[]
  results Result[]
  leaveRequests LeaveRequest[]
  homeworkSubmissions HomeworkSubmission[]
  reportCardReleases ReportCardRelease[]
}

model Attendance {
  id String @id @default(cuid())
  studentId String
  date DateTime
  status AttendanceStatus
  remarks String?
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, date])
  @@index([date, status])
}

model FeeInvoice {
  id String @id @default(cuid())
  invoiceNumber String @unique
  studentId String
  feeType String
  amount Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  netAmount Decimal @db.Decimal(12,2)
  dueDate DateTime
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments FeePayment[]
  @@index([studentId, status])
}

model FeePayment {
  id String @id @default(cuid())
  invoiceId String
  receiptNumber String @unique
  amount Decimal @db.Decimal(12,2)
  paymentMethod String?
  paidAt DateTime @default(now())
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Exam {
  id String @id @default(cuid())
  name String
  type ExamType
  term AcademicTerm?
  sessionId String
  startDate DateTime
  endDate DateTime
  status ExamStatus @default(DRAFT)
  session AcademicSession @relation(fields: [sessionId], references: [id])
  papers ExamPaper[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sessionId, status])
  @@index([sessionId, term])
}

model ExamPaper {
  id String @id @default(cuid())
  examId String
  className String
  subject String
  maxMarks Decimal @db.Decimal(8,2)
  passMarks Decimal @db.Decimal(8,2)
  examDate DateTime?
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  results Result[]
  @@unique([examId, className, subject])
}

model Result {
  id String @id @default(cuid())
  paperId String
  studentId String
  marks Decimal @db.Decimal(8,2)
  grade ResultGrade?
  remarks String?
  paper ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Cascade)
  components ResultComponent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([paperId, studentId])
  @@index([studentId])
}

model ResultComponent {
  id String @id @default(cuid())
  resultId String
  name String
  maxMarks Decimal @db.Decimal(8,2)
  marks Decimal @db.Decimal(8,2)
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@unique([resultId, name])
}

model ReportCardSubject {
  id String @id @default(cuid())
  sessionId String
  className String
  section String?
  term AcademicTerm
  subject String
  displayOrder Int @default(0)
  maxMarks Decimal @db.Decimal(8,2)
  active Boolean @default(true)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  components ReportCardComponent[]
  @@unique([sessionId, className, section, term, subject])
  @@index([sessionId, className, section, term, displayOrder])
}

model ReportCardComponent {
  id String @id @default(cuid())
  subjectId String
  name String
  maxMarks Decimal @db.Decimal(8,2)
  displayOrder Int @default(0)
  subject ReportCardSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([subjectId, name])
  @@index([subjectId, displayOrder])
}

model ReportCardRelease {
  id String @id @default(cuid())
  studentId String
  sessionId String
  snapshot Json
  snapshotHash String
  releasedBy String
  releasedAt DateTime @default(now())
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  releasedByUser User @relation(fields: [releasedBy], references: [id], onDelete: Restrict)
  @@unique([studentId, sessionId])
  @@index([sessionId, releasedAt])
  @@index([studentId, releasedAt])
}

model CommunicationNotice {
  id String @id @default(cuid())
  title String
  message String
  audience String @default("ALL")
  status String @default("PUBLISHED")
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model LeaveRequest {
  id String @id @default(cuid())
  studentId String
  startDate DateTime
  endDate DateTime
  reason String
  status String @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  reviewRemarks String?
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId, status])
}

model TimetableEntry {
  id String @id @default(cuid())
  dayOfWeek DayOfWeek
  className String
  section String?
  subject String
  teacher String
  room String?
  startTime String
  endTime String
  period Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([className, section, dayOfWeek, period])
}

model Homework {
  id String @id @default(cuid())
  title String
  description String
  className String
  section String?
  subject String
  teacher String
  assignedDate DateTime @default(now())
  dueDate DateTime
  status HomeworkStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions HomeworkSubmission[]
  @@index([className, section, dueDate])
  @@index([status, dueDate])
}

model HomeworkSubmission {
  id String @id @default(cuid())
  homeworkId String
  studentId String
  status SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt DateTime?
  feedback String?
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student Enrollment @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([homeworkId, studentId])
  @@index([studentId, status])
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(RECEPTIONIST)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  reportCardReleases ReportCardRelease[]
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
